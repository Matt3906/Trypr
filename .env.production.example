# ============================================================================
# Trypr production env — lives ONLY on the droplet at /apps/trypr/.env.production
# (deploy.sh setup creates it with generated secrets; fill in the rest). NEVER commit it.
# Values map to backend/app/core/config.py.
# ============================================================================

ENVIRONMENT=production

# --- Database (the in-compose Postgres container) ---
DB_NAME=trypr
DB_USER=trypr
DB_PASSWORD=__GENERATED__

# --- Web ---
# The site is static files on Hostinger (tryprtravel.com); this API is api.tryprtravel.com.
# CORS_ORIGINS must list the site's exact origins, and both hosts must share the
# tryprtravel.com registrable domain (the session cookie is SameSite=Lax).
CORS_ORIGINS=https://tryprtravel.com,https://www.tryprtravel.com
FRONTEND_BASE_URL=https://tryprtravel.com

# --- Auth ---
# Accounts with these emails get an admin marker on login. Everyone else is a normal user.
ADMIN_EMAILS=matthewgockiewicz@gmail.com
# SESSION_TTL_DAYS=30

# --- Password-reset email ---
# DigitalOcean blocks outbound SMTP (25/465/587), so send over HTTPS via the Gmail API.
# Mint the token once on your laptop:  python3 /path/to/Refey/deploy/scripts/get-gmail-token.py
# (OAuth consent screen must be "Internal" or the refresh token dies after 7 days.)
# Until configured, reset links are only written to the backend log.
EMAIL_PROVIDER=log
SENDER_ADDRESS=no-reply@tryprtravel.com
SENDER_NAME=Trypr
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# --- Stripe (premium) ---
# Point the Stripe webhook at https://api.tryprtravel.com/api/stripe/webhook
# (events: checkout.session.completed, customer.subscription.created/updated/deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- AI suggestions (premium) ---
# Claude API. Without a key the endpoint serves deterministic fallback suggestions.
ANTHROPIC_API_KEY=
# claude-opus-5-5 by default; claude-haiku-5-5 is much cheaper if cost matters more than quality.
# AI_MODEL=claude-opus-5-5

# --- Routing proxies (server-side keys for /api/route) ---
OPENROUTESERVICE_API_KEY=
GRAPHHOPPER_API_KEY=

# --- Uploads ---
# MAX_UPLOAD_MB=25
