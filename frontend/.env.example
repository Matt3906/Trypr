# Browser-side keys. Copy to .env.local (gitignored) and fill in.
# Backend origin. Leave blank in dev (Vite proxies /api to http://127.0.0.1:8080).
# deploy.sh sets this to https://api.tryprtravel.com for production builds.
VITE_API_BASE_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_OPENROUTESERVICE_API_KEY=
VITE_GRAPHHOPPER_API_KEY=
VITE_STRICT_ROUTING=
# Optional overrides; default to ${VITE_API_BASE_URL}/api/route and /api/overpass.
VITE_ROUTING_PROXY_URL=
VITE_OVERPASS_PROXY_URL=
VITE_CAMPSITE_INFO_MARKER_ID=
