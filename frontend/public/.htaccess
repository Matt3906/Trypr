# Enable rewrite engine
RewriteEngine On

# Serve Tournament Planner shell for direct and deep links.
RewriteRule ^tournamentPlanner/?$ /tournamentPlanner/index.html [L,QSA]
RewriteCond %{REQUEST_URI} ^/tournamentPlanner/.+
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tournamentPlanner/.*$ /tournamentPlanner/index.html [L,QSA]

# If the requested file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise redirect all routes to index.html (Flutter SPA routing)
RewriteRule ^(.*)$ /index.html [L,QSA]

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByPolicy DEFLATE text/html text/plain text/css application/javascript application/json application/wasm
</IfModule>

# Ensure browsers can stream-compile CanvasKit/SKWasm modules.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
