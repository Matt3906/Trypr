# Copy to .env and fill values (do NOT commit .env)
# Routing proxy secrets used by functions/index.js

OPENROUTESERVICE_API_KEY="ors_xxx"
GRAPHHOPPER_API_KEY="gh_xxx"

# Vertex AI (Gemini) settings used by functions/index.js

VERTEX_PROJECT="trypr-5ee47"
VERTEX_LOCATION="us-central1"
VERTEX_MODEL="gemini-1.5-flash"
# Optional: comma-separated fallback model list (tried in order)
# VERTEX_MODELS="gemini-2.0-flash-001,gemini-1.5-flash"

# Stripe billing settings
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Optional: if omitted, checkout uses inline plan pricing ($4/mo, $36/yr)
# STRIPE_PRICE_MONTHLY="price_xxx"
# STRIPE_PRICE_YEARLY="price_xxx"

# Optional: comma-separated list of allowed app origins for redirect URLs
# STRIPE_ALLOWED_ORIGINS="https://trypr.co,https://www.trypr.co,http://127.0.0.1:5500"
# STRIPE_SUCCESS_PATH="/premium"
# STRIPE_CANCEL_PATH="/premium"
# STRIPE_PORTAL_RETURN_PATH="/premium"
